# Copy to .env — NEVER commit the real .env

# --- Arbitrum Sepolia (only needed to deploy to the testnet) ---
ARBITRUM_SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
# Use a throwaway testnet key only. Never a key holding real funds. Deployer = registrar.
DEPLOYER_PRIVATE_KEY=

# --- Contract parameters (required on the testnet; the local chain has dev defaults) ---
QUORUM=
BIDDING_PERIOD_SECONDS=
VOTING_PERIOD_SECONDS=

# --- IPFS (supplier portal) ---
PINATA_JWT=
PINATA_GATEWAY=
